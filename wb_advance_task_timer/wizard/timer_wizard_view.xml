<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_timer_wizard_form" model="ir.ui.view">
        <field name="name">project.task.timer.wizard.form</field>
        <field name="model">project.task.timer.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Timer">
                <group>
                    <field name="user_id"/>
                    <field name="project_id"/>
                    <field name="task_id"/>
                    <field name="start_date"/>
                </group>
                <footer>
                    <button string="Start Timer" name="action_start_task" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timer_wizard" model="ir.actions.act_window">
        <field name="name">Start Timer</field>
        <field name="res_model">project.task.timer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
